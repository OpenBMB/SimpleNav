  "framework": {
    "eyebrow": {"en": "ONE RESEARCH LOOP", "zh": "一条研究闭环"},
    "title": {"en": "From raw trajectories to reliable decisions.", "zh": "从原始轨迹到可靠决策。"},
    "lead": {"en": "Select a layer to see what stays stable and where new datasets, models, or benchmarks plug in.", "zh": "选择一个层次，查看哪些内容保持稳定，以及新的数据集、模型和 benchmark 如何接入。"}
