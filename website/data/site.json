    {"id": "backbone", "label": {"en": "Backbone", "zh": "视觉语言骨干"}, "title": {"en": "Qwen3.5-VL for navigation.", "zh": "面向导航的 Qwen3.5-VL。"}, "text": {"en": "The Release 01 path uses Qwen3.5-VL for language, current vision, and navigation context.", "zh": "Release 01 使用 Qwen3.5-VL 处理语言、当前视觉和导航上下文。"}, "tags": ["Qwen3.5-VL", "navigation VLA", "backbone adapter"]},
