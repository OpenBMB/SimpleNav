  "frameworkNodes": {
    "data": {"label": {"en": "Data", "zh": "数据"}, "subtitle": {"en": "convert · normalize", "zh": "转换 · 归一化"}, "title": {"en": "Make heterogeneous data inspectable.", "zh": "让异构数据可检查。"}, "text": {"en": "Dataset adapters capture source layout, camera, time, coordinate, and action semantics before writing a common LeRobot v3 representation.", "zh": "数据集 adapter 在写入统一 LeRobot v3 表示前，明确记录源目录、相机、时间、坐标和动作语义。"}, "items": [{"en": "OpenFly · TravelUAV · AerialVLN", "zh": "OpenFly · TravelUAV · AerialVLN"}, {"en": "trajectory augmentation and rendering", "zh": "轨迹增强与模拟器采集"}, {"en": "validation, statistics, and manifests", "zh": "校验、统计和 manifest"}]},
    "protocol": {"label": {"en": "Protocol", "zh": "协议"}, "subtitle": {"en": "state · action · history", "zh": "状态 · 动作 · 历史"}, "title": {"en": "Make semantics explicit.", "zh": "让语义保持显式。"}, "text": {"en": "A stable intermediate contract connects data, models, and evaluation without pretending that every task has the same coordinates or actions.", "zh": "稳定的中间协议连接数据、模型和测评，同时不强行假设所有任务拥有相同坐标和动作。"}, "items": [{"en": "adapter-declared storage and body-frame model motion", "zh": "adapter 声明的存储语义与机体坐标系模型运动"}, {"en": "camera, time, and history contracts", "zh": "相机、时间和历史契约"}, {"en": "shared normalization statistics", "zh": "共享归一化统计"}]},
    "model": {"label": {"en": "Model", "zh": "模型"}, "subtitle": {"en": "VLM · memory · head", "zh": "VLM · 记忆 · 动作头"}, "title": {"en": "Keep the architecture composable.", "zh": "保持模型架构可组合。"}, "text": {"en": "Current observations, selected history, temporal-view information, platform state, and a continuous action head form the SimpleNAV navigation path.", "zh": "当前观测、筛选历史、时空视角信息、平台状态和连续动作头共同构成 SimpleNAV 导航路径。"}, "items": [{"en": "Qwen3.5-VL primary path", "zh": "Qwen3.5-VL 主要路径"}, {"en": "BATS · TVI · visual-token cache", "zh": "BATS · TVI · 视觉 token cache"}, {"en": "DiT-B · 8-step waypoint chunk", "zh": "DiT-B · 8 步 waypoint chunk"}]},
    "train": {"label": {"en": "Train", "zh": "训练"}, "subtitle": {"en": "single · multi-domain", "zh": "单域 · 多域"}, "title": {"en": "Turn contracts into repeatable recipes.", "zh": "把契约变成可复现 recipe。"}, "text": {"en": "Configuration-driven runs connect data mixtures, normalization, distributed execution, checkpoint metadata, and recovery.", "zh": "配置驱动流程连接数据混合、归一化、分布式执行、checkpoint 元数据和恢复。"}, "items": [{"en": "single-dataset smoke tests", "zh": "单数据集 smoke test"}, {"en": "cross-domain mixture recipes", "zh": "跨域混合训练 recipe"}, {"en": "resolved configs and checkpoint contracts", "zh": "resolved config 与 checkpoint 契约"}]},
    "eval": {"label": {"en": "Evaluate", "zh": "测评"}, "subtitle": {"en": "offline · closed-loop", "zh": "离线 · 闭环"}, "title": {"en": "Make comparisons auditable.", "zh": "让比较可以审计。"}, "text": {"en": "Benchmark adapters and simulator backends share planning, resume, episode artifacts, failure records, and aggregate metrics.", "zh": "Benchmark adapter 与模拟器后端共享规划、断点恢复、episode 产物、失败记录和汇总指标。"}, "items": [{"en": "AirSim · Habitat · offline", "zh": "AirSim · Habitat · 离线"}, {"en": "episode-level results", "zh": "逐 episode 结果"}, {"en": "protocol-bound benchmark summaries", "zh": "绑定协议的 benchmark 汇总"}]}
  },
