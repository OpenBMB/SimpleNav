  "principles": {
    "protocol": {"title": {"en": "Shared infrastructure", "zh": "共享基础设施"}, "text": {"en": "Storage, loading, configs, and artifacts are shared. Task-specific coordinate and action semantics stay explicit.", "zh": "存储、加载、配置和产物统一；任务特有的坐标与动作语义保持显式。"}},
    "interface": {"title": {"en": "Extension through interfaces", "zh": "通过接口扩展"}, "text": {"en": "New datasets, model parts, and benchmarks add adapters or plugins instead of special cases in the common loop.", "zh": "新增数据集、模型组件和 benchmark 通过 adapter 或插件接入，而不是在公共闭环中累积特例。"}},
    "repro": {"title": {"en": "Reproduction as an artifact", "zh": "复现本身是产物"}, "text": {"en": "A score travels with its code, data, config, checkpoint, simulator, episode records, and raw summary.", "zh": "一个分数必须携带代码、数据、配置、checkpoint、模拟器、episode 记录和原始汇总。"}}
  },
